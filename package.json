  "scripts": {
    "build": "tsup && bun run build:styles",
    "build:styles": "cp src/styles/tokens.css dist/tokens.css && cp src/styles/fonts.css dist/fonts.css",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:e2e:tablet": "playwright test --project=tablet-chromium",
    "test:visual": "playwright test tests/e2e/visual.spec.ts --project=chromium",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --project=chromium --update-snapshots",
    "test:storybook": "test-storybook --url http://localhost:6006",
    "test:storybook:ci": "concurrently -k -s first -n SB,TR \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:6006 && test-storybook --url http://localhost:6006\"",
    "sync:coverage": "vitest run --coverage && bun scripts/sync-coverage.ts",
    "sync:e2e-stats": "bun scripts/sync-e2e-stats.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version && biome check --write package.json CHANGELOG.md",
    "changeset:publish": "changeset publish",
    "coverage:gate": "bun scripts/coverage-gate.ts",
    "ci:local": "bun run lint && bun run typecheck && bun run test:coverage && bun run coverage:gate && bun run build && bun run build-storybook"
  },
